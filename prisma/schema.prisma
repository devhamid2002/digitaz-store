generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id            String   @id @default(uuid())
  // slug is the canonical lookup key for routes and seed upserts
  slug          String   @unique
  name          String
  category      String
  description   String
  image         String
  // price fields are minor currency units; discount is a percent, not derived
  price         Int
  originalPrice Int?
  discount      Int?
  brand         String
  stock         Int
  rating        Float
  ratingCount   Int
  viewCount     Int      @default(0)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
